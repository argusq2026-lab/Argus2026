<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Camera-first palette: the preview is the content, chrome recedes. -->
    <color name="surface">#0E1113</color>
    <color name="surface_raised">#CC161A1D</color>
    <color name="on_surface">#F2F5F7</color>
    <color name="on_surface_dim">#96A0A8</color>

    <!-- State colours, used consistently: live, attention, fault. -->
    <color name="live">#3DDC97</color>
    <color name="live_dim">#333DDC97</color>
    <color name="attention">#FFBE3D</color>
    <color name="fault">#FF6B6B</color>

    <color name="action">#2A3138</color>
    <color name="action_pressed">#39424A</color>
    <color name="scrim">#B3000000</color>

    <!-- Dashboard tile accents (DashboardActivity). One color per domain so
         the tiles read as genuinely different modes, not four reskins of the
         same card. `live` (fitness's own accent, above) doubles as the
         Fitness tile's color: it is the one domain that is actually live. -->
    <color name="tile_nursing">#4FB3D9</color>
    <color name="tile_lab">#B084F5</color>
    <color name="tile_welding">#FF7A33</color>
</resources>
