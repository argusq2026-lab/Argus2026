<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Envelopes go to the PC over the local network. No INTERNET-wide use;
         the aggregator is on the same floor. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Discovery.kt listens for the laptop's UDP beacon so nobody has to type
         an IP into every phone. Wi-Fi firmware drops broadcast frames to save
         power unless a multicast lock is held, which is what this permits:
         without it the socket is correct and simply never receives anything.
         Normal permission, granted at install; no runtime prompt. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="true"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArgusEdge">

        <!-- QNN dlopens the vendor cDSP client at runtime. Bundled .so files
             live in the app linker namespace and cannot see /vendor by
             default; these are listed in /vendor/etc/public.libraries.txt,
             and API 31+ requires declaring them to get namespace access. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false"/>
        <uses-native-library android:name="libadsprpc.so" android:required="false"/>
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>

        <!--
          Rotation is handled in-process rather than by activity recreation.

          The default behaviour on rotation is to destroy and recreate the
          activity, which here would close and reopen the QNN NPU sessions and
          drop the WebSocket mid-class. Session creation is not cheap and the
          server treats a reconnect as a fresh `hello`, so a trainee turning
          their phone would cost a visible stall and a rank gap. Declaring these
          configChanges keeps the process alive and routes rotation to
          onConfigurationChanged, which only has to retarget the camera.
        -->
        <!-- The nursing station. A separate Activity rather than a mode inside
             MainActivity: that screen is fitness's, and the two share classes
             rather than a file. Same configChanges for the same reason. -->
        <activity
            android:name=".NursingActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"/>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"/>

        <!-- The launcher screen. MainActivity used to hold the LAUNCHER
             intent-filter directly; it moved here so the app opens on the
             dashboard first, with Fitness one tap away rather than the only
             thing the app can do. -->
        <activity
            android:name=".DashboardActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
