# Leftover local model artifacts from the retired on-device vision pipeline
# (see docs/VALIDATION.md) -- nothing in this repo reads models/ anymore.
models/

# Venv (see run.ps1).
.venv/

# Runtime output
out/
*.jsonl
# `argus run` redirected to files during device testing; not build output that
# belongs to any target, just whatever the last local session happened to say.
argus_server_*.log

# `argus demo` regenerates this fixture; it is build output, not an asset.
demo/synthetic_stream.json

# Training data downloaded by scripts/train_form_model.py (labelled landmark
# CSVs, tens of MB per exercise). The fitted coefficients are committed; the
# corpus they came from is fetched on demand -- see THIRD-PARTY-NOTICES.md.
scratch/

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage

.env

# Android module build outputs. The Gradle wrapper itself IS committed, so a
# fresh clone can build without a local Gradle install.
android/.gradle/
android/build/
android/app/build/
android/.kotlin/
android/local.properties
*.apk

# Model weights fetched by exporters into the working directory. Ultralytics
# downloads yolo*.pt next to the process on from_pretrained(), which is how an
# AGPL-3.0 file once got committed to this MIT repository by a `git add -A`.
# Weights are never committed here; see android/models.json for how they are
# reproduced instead.
*.pt
*.pth
*.tflite
yolo*.onnx
